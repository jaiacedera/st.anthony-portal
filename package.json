{
  "name": "st.anthony-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:public": "node scripts/check-public.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "node --watch backend/src/server.js",
    "build": "tsc -b && vite build --config frontend/vite.config.ts",
    "lint": "eslint . --config frontend/eslint.config.js",
    "test": "node --experimental-test-module-mocks --test backend/database/*.test.js backend/src/services/*.test.js backend/src/middleware/*.test.js backend/src/utils/*.test.js frontend/src/utils/*.test.mjs",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start:backend": "node backend/src/server.js",
    "init:sheets": "node backend/database/initSheets.js",
    "migrate:auth": "node scripts/migrate-auth-to-sheets.mjs"
  },
  "dependencies": {
    "googleapis": "^162.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
